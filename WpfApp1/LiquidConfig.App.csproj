<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <RootNamespace>LiquidConfig.App</RootNamespace>
    <AssemblyName>LiquidConfig.App</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Communication\**" />
    <Compile Remove="Models\**" />
    <EmbeddedResource Remove="Communication\**" />
    <EmbeddedResource Remove="Models\**" />
    <None Remove="Communication\**" />
    <None Remove="Models\**" />
    <Page Remove="Communication\**" />
    <Page Remove="Models\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.14" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\src\LiquidConfig.Core\LiquidConfig.Core.csproj" />
  </ItemGroup>

</Project>
