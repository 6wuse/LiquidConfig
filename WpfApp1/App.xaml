<Application x:Class="LiquidConfig.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:LiquidConfig.App"
             xmlns:viewmodel="clr-namespace:LiquidConfig.App.ViewModels"
             xmlns:view="clr-namespace:LiquidConfig.App.Views">
    <Application.Resources>
        <DataTemplate DataType="{x:Type viewmodel:CanvasViewModel}">
            <view:CanvasView/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodel:ViewModel2}">
            <view:View2/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type viewmodel:ViewModel3}">
            <view:View3/>
        </DataTemplate>
    </Application.Resources>
</Application>
