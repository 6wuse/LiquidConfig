<Window x:Class="LiquidConfig.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:LiquidConfig.App.Control"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Window.Resources> <!--这个窗口中所有的按钮都可以使用这个资源-->
        <Style TargetType="{x:Type local:NavigationButton}">            <!--Syle规则专门作用于NavigationButton-->
            <!-- 默认外观 -->
            <Setter Property="DefaultBackground" Value="#F8FAFC"/>
            <Setter Property="HoverBackground" Value="Black"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="100"/>
            <!--控件模板，Template指控件外观-->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:NavigationButton}">
                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--多条件触发器-->
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <!--鼠标接触，但没有点击-->
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter Property="Background" Value="{Binding HoverBackground,RelativeSource={RelativeSource Self}}"/>
                            </MultiTrigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="DodgerBlue"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate> 
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type local:RadiusButton}">
            <!--第一次绑定是给 RadiusButton 自身的 Background 赋值-->
            <!--RadiusButton.Background <= RadiusButton.DefaultBackground;-->
            <!--Background是继承的属性-->
            <Setter Property="Background" Value="{Binding DefaultBackground,RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type local:RadiusButton}">
                        <!--第二次绑定是让模板内部 Border 的 Background 使用 RadiusButton 的 Background-->
                        <!--RadiusButton 和 Border 是两个不同的对象。-->
                        <!--TemplateBinding 的作用，就是把模板属性与控件依赖属性关联起来-->
                        <Border x:Name="ButtonBorder" Background="{TemplateBinding Background}" 
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>

                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1"/>
                            </Border.RenderTransform>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{Binding HoverBackground,RelativeSource={RelativeSource Self}}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{Binding PressedBackground,RelativeSource={RelativeSource Self}}"/>
                                <!--这里直接对名字为ButtonBorder的Border中的属性RenderTransform进行值修改-->
                                <!--如果后面需要找到这个对象并单独操作它，就为它起一个名字-->
                                <Setter TargetName="ButtonBorder" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.97" ScaleY="0.97"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    
    
    
    
    <DockPanel>
        <Border DockPanel.Dock="Top">
            <TextBlock Text="项目模板" FontSize="18"/>
        </Border>
        <Border DockPanel.Dock="Left">
            <StackPanel>
                <local:NavigationButton Content="组态画布" Height="50"  Margin="0,0,0,5"
                                        CornerRadius="10" HoverBackground="#5B9BD5" GroupName="NavigationGroup"
                                        Command="{Binding NavigateCommand}" CommandParameter="CanvasView"/>
                <local:NavigationButton Content="界面2" Height="50"  Margin="0,0,0,5"
                                        CornerRadius="10" HoverBackground="#5B9BD5" GroupName="NavigationGroup"
                                        Command="{Binding NavigateCommand}" CommandParameter="View2"/>
                <local:NavigationButton Content="界面3" Height="50"  Margin="0,0,0,5"
                                        CornerRadius="10" HoverBackground="#5B9BD5" GroupName="NavigationGroup"
                                        Command="{Binding NavigateCommand}" CommandParameter="View3"/>
            </StackPanel>
        </Border>
        <Border DockPanel.Dock="Right">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Border>
    </DockPanel>

</Window>